{
  "name": "Resolve aí",
  "module": "src/app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "db:migrate": "bun run db/migrate.ts",
    "db:seed": "bun run db/seed.ts",
    "openapi:validate": "bun run scripts/validate-openapi.ts",
    "lint": "bun run typecheck",
    "test": "NODE_ENV=test bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jest": "^30.5.1",
    "pg": "^8.23.0"
  }
}
