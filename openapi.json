{
  "openapi": "3.1.0",
  "info": {
    "title": "Resolve Aí API",
    "version": "1.0.0",
    "description": "Incident management API. All dates are UTC ISO 8601 values."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IncidentId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "AttachmentId": {
        "in": "path",
        "name": "attachmentId",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "details", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": {} },
              "requestId": { "type": "string" }
            }
          }
        }
      },
      "IncidentStatus": {
        "type": "string",
        "enum": ["open", "under_review", "in_progress", "resolved", "cancelled"]
      },
      "IncidentPriority": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"]
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "$ref": "#/components/schemas/IncidentStatus" },
          "priority": { "$ref": "#/components/schemas/IncidentPriority" },
          "version": { "type": "integer" }
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 200
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "RefreshTokenInput": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": { "refreshToken": { "type": "string" } }
      },
      "CreateIncidentInput": {
        "type": "object",
        "required": ["categoryId", "title", "description", "address"],
        "properties": {
          "categoryId": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 3, "maxLength": 200 },
          "description": { "type": "string", "minLength": 3 },
          "address": { "type": "string", "minLength": 1, "maxLength": 300 },
          "locationDetails": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
        }
      },
      "CommentInput": {
        "type": "object",
        "required": ["body"],
        "properties": { "body": { "type": "string", "minLength": 1 } }
      },
      "RatingInput": {
        "type": "object",
        "required": ["score"],
        "properties": {
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string", "minLength": 1 }
        }
      },
      "PriorityInput": {
        "type": "object",
        "required": ["priority", "reason", "version"],
        "properties": {
          "priority": { "$ref": "#/components/schemas/IncidentPriority" },
          "reason": { "type": "string", "minLength": 1 },
          "version": { "type": "integer" }
        }
      },
      "AssigneeInput": {
        "type": "object",
        "required": ["assigneeId", "reason", "version"],
        "properties": {
          "assigneeId": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 1 },
          "version": { "type": "integer" }
        }
      },
      "TransitionInput": {
        "type": "object",
        "required": ["to", "version"],
        "properties": {
          "to": { "$ref": "#/components/schemas/IncidentStatus" },
          "observation": { "type": "string", "minLength": 1 },
          "solution": { "type": "string", "minLength": 1 },
          "version": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "responses": {
          "200": { "description": "Healthy" },
          "503": { "description": "Database unavailable" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Requester created" },
          "409": { "description": "Email exists" },
          "422": { "description": "Invalid input" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Rotated tokens" },
          "401": { "description": "Invalid refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenInput" }
            }
          }
        },
        "responses": { "204": { "description": "Logged out" } }
      }
    },
    "/me": {
      "get": { "responses": { "200": { "description": "Current user" } } }
    },
    "/categories": {
      "get": { "responses": { "200": { "description": "Active categories" } } }
    },
    "/incidents": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": { "$ref": "#/components/schemas/IncidentStatus" }
          },
          {
            "in": "query",
            "name": "priority",
            "schema": { "$ref": "#/components/schemas/IncidentPriority" }
          },
          {
            "in": "query",
            "name": "categoryId",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "in": "query",
            "name": "assigneeId",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "in": "query",
            "name": "createdFrom",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "in": "query",
            "name": "createdTo",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "enum": ["createdAt", "-createdAt", "priority", "-priority"]
            }
          }
        ],
        "responses": { "200": { "description": "Paginated incidents" } }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateIncidentInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Incident created" },
          "403": { "description": "Requester role required" },
          "422": { "description": "Invalid input" }
        }
      }
    },
    "/incidents/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "get": {
        "responses": {
          "200": { "description": "Incident" },
          "404": { "description": "Not visible" }
        }
      }
    },
    "/incidents/{id}/history": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "get": {
        "responses": { "200": { "description": "Chronological audit history" } }
      }
    },
    "/incidents/{id}/comments": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "get": { "responses": { "200": { "description": "Comments" } } },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CommentInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Comment created" },
          "422": { "description": "Invalid input" }
        }
      }
    },
    "/incidents/{id}/attachments": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "post": {
        "parameters": [
          {
            "in": "header",
            "name": "X-File-Name",
            "schema": { "type": "string", "maxLength": 255 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": { "type": "string", "format": "binary" }
            },
            "image/png": { "schema": { "type": "string", "format": "binary" } },
            "image/webp": { "schema": { "type": "string", "format": "binary" } }
          }
        },
        "responses": {
          "201": { "description": "Attachment uploaded" },
          "413": { "description": "Too large" },
          "415": { "description": "Invalid image" }
        }
      }
    },
    "/incidents/{id}/attachments/{attachmentId}": {
      "parameters": [
        { "$ref": "#/components/parameters/IncidentId" },
        { "$ref": "#/components/parameters/AttachmentId" }
      ],
      "get": {
        "responses": {
          "200": { "description": "Image contents" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/incidents/{id}/rating": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RatingInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Rating created" },
          "409": { "description": "Invalid state or duplicate" },
          "422": { "description": "Invalid input" }
        }
      }
    },
    "/incidents/{id}/priority": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PriorityInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Priority changed" },
          "409": { "description": "Version conflict or unchanged priority" },
          "422": { "description": "Invalid input" }
        }
      }
    },
    "/incidents/{id}/assignee": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssigneeInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Assignee changed" },
          "409": { "description": "Version conflict or unchanged assignee" },
          "422": { "description": "Invalid input" }
        }
      }
    },
    "/incidents/{id}/transitions": {
      "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransitionInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Status changed" },
          "409": { "description": "Invalid transition or version conflict" },
          "422": { "description": "Invalid input" }
        }
      }
    },
    "/dashboard/summary": {
      "get": { "responses": { "200": { "description": "Manager dashboard" } } }
    }
  }
}
